# Ignore the contents of the _site directory and other cache directories
_site/
.sass-cache/

# Ignore the directory for local files during development
local/

# Ignore the Gemfile that is generated
Gemfile.lock

# Ingore files created by npm
node_modules
package-lock.json

.jekyll-metadata
_projects/.DS_Store
.DS_Store

# Local release checks and working notes are not part of the public repository.
/scripts/
/.superpowers/
/_new/
/.jekyll-cache/
/docs/*
!/docs/adding-site-content.md
!/docs/templates/
